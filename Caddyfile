# Caddy reverse proxy for Precast CRM.
# HTTPS via sslip.io: 207-154-218-194.sslip.io -> the droplet IP, real
# Let's Encrypt cert. The bare IP is kept on plain HTTP as a fallback.
# Primary domain: etalontbm.uz.
#
# NOTE: this file is bind-mounted into the caddy container
# (./Caddyfile:/etc/caddy/Caddyfile). git pull replaces the file inode,
# so after changing it run `docker compose up -d --force-recreate caddy`
# — a plain restart keeps serving the OLD content.

(site) {
  encode zstd gzip

  # JSON access log to stdout (docker logs). Includes per-request
  # `duration` — this is the data we lacked when diagnosing the
  # 2026-07 slowness; keep it on so slow endpoints are measurable.
  log {
    output stdout
    format json
  }

  request_body {
    max_size 64MB
  }
  handle /ws* {
    reverse_proxy ws-bridge:8765
  }
  handle /uploads/* {
    root * /srv
    file_server
  }
  handle {
    reverse_proxy app:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
}

207-154-218-194.sslip.io {
  import site
}

http://207.154.218.194 {
  import site
}

etalontbm.uz {
  import site
}

www.etalontbm.uz {
  redir https://etalontbm.uz{uri} permanent
}
