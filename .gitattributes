# Auto detect text files and perform LF normalization
* text=auto

# Generated contract artifacts are written with LF by their export scripts and
# compared byte-for-byte by `golden:check` / `openapi:check`. Without pinning,
# a Windows checkout rewrites them to CRLF and both checks fail on a clean tree.
docs/api/calc-golden.json text eol=lf
docs/api/openapi.json text eol=lf
